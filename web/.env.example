# Vercel'de bu iki değişkeni Environment Variables olarak ekleyin.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---- Mülakat: Google Form webhook'u (api/mulakat/form) ----
# İkisi de YALNIZCA sunucuda okunur — başlarına NEXT_PUBLIC_ koymayın.
# Service role anahtarı RLS'i atlar: Supabase → Project Settings → API.
# Secret: en az 16 karakter rastgele metin; Apps Script'teki PANEL_SECRET
# ile aynı olmalı (scripts/google-form-mulakat.gs).
# Boş bırakılırsa webhook 503 döner, panelin geri kalanı etkilenmez.
SUPABASE_SERVICE_ROLE_KEY=
MULAKAT_WEBHOOK_SECRET=

# CesiumJS Ion token — 3D uçuş görünümü için (cesium.com/ion'dan ücretsiz alınır)
# Boş bırakılırsa 3D görünüm kapalı kalır, 2D harita çalışmaya devam eder.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
