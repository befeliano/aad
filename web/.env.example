# Vercel'de bu iki değişkeni Environment Variables olarak ekleyin.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# CesiumJS Ion token — 3D uçuş görünümü için (cesium.com/ion'dan ücretsiz alınır)
# Boş bırakılırsa 3D görünüm kapalı kalır, 2D harita çalışmaya devam eder.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
